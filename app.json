{
  "expo": {
    "name": "RentAny",
    "slug": "rentany",
    "scheme": "rentany",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentany.app",
      "buildNumber": "1",
      "associatedDomain": [],
      "infoPlist": {
        "NSCameraUsageDescription": "RentAny needs camera access to verify your identity and take photos of items.",
        "NSPhotoLibraryUsageDescription": "RentAny needs photo library access to upload item images.",
        "NSLocationWhenInUseUsageDescription": "RentAny uses your location to find items near you.",
        "NSMicrophoneUsageDescription": "RentAny needs microphone access for video recordings of items.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rentany.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "adjustPan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/withLottieDowngrade",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "./plugins/withIosDeploymentTarget"
    ],
    "extra": {
      "eas": {
        "projectId": "afe26263-a4ee-467d-9808-11108d3490f5"
      }
    }
  }
}
